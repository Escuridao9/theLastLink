{
  "name": "the-last-link",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
  "ng": "ng",
  "configure": "node --env-file-if-exists=.env scripts/configure-supabase.mjs && node --env-file-if-exists=.env ../scripts/configure-web.mjs",
  "prestart": "npm run configure",
  "start": "ng serve",
  "prebuild": "npm run configure",
  "build": "ng build",
  "prewatch": "npm run configure",
  "watch": "ng build --watch --configuration development",
  "pretest": "npm run configure",
  "test": "ng test",
  "pretypecheck": "npm run configure",
  "typecheck": "tsc --project tsconfig.app.json --noEmit"
},
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@angular/build": {
      "undici": "7.30.1"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
